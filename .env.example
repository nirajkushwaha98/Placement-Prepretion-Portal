# ==============================================================================
# PLACEMENT PREPARATION PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-placement-preparation-portal-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL or SQLite fallback)
# Leave DB_NAME empty to automatically use SQLite db.sqlite3 for local quickstart
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Judge0 Sandboxed Code Execution API
# Free public endpoint or self-hosted Judge0 instance
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Placement Readiness Weights (Sum to 1.0)
WEIGHT_APTITUDE=0.25
WEIGHT_CODING=0.30
WEIGHT_RESUME=0.20
WEIGHT_INTERVIEW=0.25
